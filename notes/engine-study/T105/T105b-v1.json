    {
      "decision": "Freeze16 uniform-without-replacement mainseed words percontext from separate named sampler streams; exactlists/schedule inledger,actualsetsdisjoint,noresampling.",
      "limits": "PRNG-generated Monte Carlo design targets each fixed context\u2019s finite seed universe,not independent football fixtures or synchronized laterdraws.",
      "topic": "seed-blocks",
      "why": "Independent unit is a seed/context block carrying four potential outcomes; different contexts remain fixed strata."
    },
    {
      "decision": "PrimaryY=managedscored>=1 retainedfriendlygoal. I=(Y16Q1-Y16Q0)-(Y32Q1-Y32Q0);equalmeanA/B. Othergate/statistic contrasts exploratory.",
      "limits": "Friendlyscenario/liveenergyinterventiononly;no claim about naturally generated condition,allcountries,formationrank ornewstandaloneengine.",
      "topic": "estimands",
      "why": "One prespecified boundedprimarynet-effect interaction;source localgate directiondoesnot dictatewholematchgoals."
    },
    {
      "decision": "Compute16blockI values/context; finite-uniform-seed Hoeffding range4 bound at97.5% percontext;clip[-2,2],averagecontextintervals forsimultaneous95% target. ReportrawSD/counts asdescriptive.",
      "limits": "Nominal samplingcoverageassumesuniformseedselection;deterministicPRNG/pseudorandomsimulation limitations explicit. Halfwidth1.4802 isdeliberatelywide;noequivalenceor0.1-effectclaim.",
      "topic": "uncertainty",
      "why": "Preservepairedblock covariance;unionboundcoversbothcontextswithoutassumingcontextsareindependentnewfixtures."
    },
