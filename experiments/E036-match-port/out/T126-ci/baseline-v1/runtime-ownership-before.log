 checkpoint cases run independently; general holds every other test.\n  # A status is reported for every non-draft PR, and nightly/manual runs.  The first step chooses the tier; the others run\n  # when the tier asks for them.  A green `checks` on a PR head means every obligation of the\n  # whole PR\'s diff has been met (tools/ci_gate.py explains why a docs-only push to a code PR may\n  # run less).\n  checks:\n    name: checks (${{ matrix.group }})\n    if: github.event_name != \'push\' && (github.event_name != \'pull_request\' || !github.event.pull_request.draft)\n    runs-on: ubuntu-latest\n    # [designed: owner, 2026-10-30] No cap on parallel groups: every group starts at once (4 at a time held the\n    # twelve-group full run on the Candidate of #629 for about five hours).\n    strategy:\n      fail-fast: false\n      matrix:\n        group: [general, e034-01, e033-06, e034-02, e033-01, e033-02, e033-03, e033-04, e033-05, e033-07, e034-03, seal]\n    env:\n      GH_TOKEN: ${{ github.token }}\n    steps:\n      - uses: actions/checkout@v4\n        with:\n          fetch-depth: 0\n      - uses: actions/setup-python@v5\n        with:\n          python-version: \'3.12\'\n      - id: gate\n        env:\n          EVENT: ${{ github.event_name }}\n          ACTION: ${{ github.event.action }}\n          BASE: ${{ github.event.pull_request.base.sha }}\n          HEAD: ${{ github.event.pull_request.head.sha }}\n          BEFORE: ${{ github.event.before }}\n          REPO: ${{ github.repository }}\n        run: python3 tools/ci_gate.py decide >> "$GITHUB_OUTPUT"\n      # Relative Markdown links resolve and JSON files parse.\n      - if: steps.gate.outputs.quick == \'true\'\n        run: python3 tools/check_links.py\n      # G2: the artifact is a release asset; the workflow\'s token fetches it (never committed).\n      # goal2-67cf27d6 is the set the driver and new runs name (it declares the runtime writes,\n      # F001); goal2-a949da2f stays fetched for tests/static, whose released-file tests read its\n      # cache path. The files are identical (T11).\n      - if: steps.gate.outputs.code == \'true\'\n        run: python3 tools/fetch_artifact.py goal2-67cf27d6\n      - if: steps.gate.outputs.code == \'true\'\n        run: python3 tools/fetch_artifact.py goal2-a949da2f\n      # The static tools need capstone, and the released-file tests the artifact fetched above.\n      # The emulator tests (tests/test_emul_*.py and the other modules that import unicorn) need unicorn,\n      # pinned at the 2.1.4 the engine work and E018\'s records use (issue #304): without it they skip.\n      - if: steps.gate.outputs.code == \'true\'\n        uses: actions/cache@v4\n        with:\n          path: ~/.cache/pip\n          key: pip-${{ runner.os }}-${{ hashFiles(\'tools/static/requirements.txt\', \'runtime/emul/requirements.txt\') }}\n      - if: steps.gate.outputs.code == \'true\'\n        run: pip install -r tools/static/requirements.txt -r runtime/emul/requirements.txt\n      - if: steps.gate.outputs.code == \'true\' && matrix.group == \'general\'\n        run: python3 -m unittest discover -s tests/static -v\n      # T34: the human-recorder tests need a nested X display stack (Xephyr inside Xvfb) and the\n      # emulator; tests that require it skip themselves (skipUnless) when a tool is missing, so\n      # the assertions still run wherever the stack is present.\n      # The packages\' .deb files are cached between runs (2026-10-22: the runners\' Ubuntu mirror served them at a few\n      # KB/s and the install, ffmpeg\'s ~70 dependencies, ran 40 minutes twice); a cache hit installs without\n      # downloading them. A slow mirror stops the step at 15 minutes instead of holding the job.\n      - if: steps.gate.outputs.code == \'true\' && matrix.group == \'general\'\n        uses: actions/cache@v4\n        with:\n          path: ~/apt-archives\n          key: apt-${{ runner.os }}-${{ hashFiles(\'.github/workflows/ci.yml\') }}\n          restore-keys: apt-${{ runner.os }}-\n      - if: steps.gate.outputs.code == \'true\' && matrix.group == \'general\'\n        timeout-minutes: 15\n        run: |\n          mkdir -p ~/apt-archives/partial\n          sudo apt-get update\n          sudo apt-get install -y -o Dir::Cache::Archives="$HOME/apt-archives" \\\n            xvfb xserver-xephyr xinput xdotool x11-utils ffmpeg dosbox-x\n          sudo chown -R "$(id -u):$(id -g)" ~/apt-archives\n      # The record tools, their tests and fixtures (the fetched checker and artifact stay in .cache/).\n      # The six slow modules (tools/ci_gate.py SLOW) run only when the gate names them.\n      - if: steps.gate.outputs.code == \'true\'\n        run: python3 tools/ci_gate.py run-tests --modules="${{ steps.gate.outputs.modules }}" --group="${{ matrix.group }}"\n      # T37: every finding\'s citations resolve under the pinned checker (U25-U27).\n      - if: steps.gate.outputs.quick == \'true\'\n        run: for f in findings/F*.md; do python3 tools/check_citations.py "$f"; done\n      # No original file is ever in the tree (U17: they are release assets only).\n      - if: steps.gate.outputs.quick == \'true\'\n        run: "! git ls-files | grep -iE \'\\\\.(exe|dat|hlp|hil|pif|bat)$\'"\n'

